---
interface Props {
    type: 'sheridan-corner' | 'oak-acorn' | 'basketweave-border' | 'lasso-loop' | 'spur-rowel' | 'concho-rosette' | 'wild-rose';
    class?: string;
    flip?: 'horizontal' | 'vertical' | 'both' | 'none';
    opacity?: string;
    color?: string;
}

const { 
    type, 
    class: className = '', 
    flip = 'none',
    opacity = 'opacity-35',
    color = 'text-[#78350F]'
} = Astro.props;

let flipClass = '';
if (flip === 'horizontal') flipClass = '-scale-x-100';
if (flip === 'vertical') flipClass = '-scale-y-100';
if (flip === 'both') flipClass = '-scale-100';
---

<div class={`pointer-events-none select-none z-10 ${color} ${opacity} ${flipClass} ${className}`} aria-hidden="true">
    {type === 'sheridan-corner' && (
        <svg viewBox="0 0 160 160" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <path d="M10 150 C 10 70, 70 10, 150 10" stroke="currentColor" stroke-width="1.8" stroke-dasharray="5 3.5" />
            <path d="M22 150 C 22 80, 80 22, 150 22" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3.5 3" />
            
            <path d="M50 150 C 50 110, 85 90, 105 105 C 120 115, 115 135, 95 135 C 80 135, 75 120, 85 110" stroke="currentColor" stroke-width="1.6" stroke-dasharray="5 3.5" fill="none" />
            <path d="M150 50 C 110 50, 90 85, 105 105" stroke="currentColor" stroke-width="1.6" stroke-dasharray="5 3.5" fill="none" />
            
            <circle cx="58" cy="58" r="9" stroke="currentColor" stroke-width="1.6" stroke-dasharray="4 2.5" />
            <circle cx="58" cy="58" r="4.5" stroke="currentColor" stroke-width="1.4" />
            <circle cx="58" cy="58" r="2" fill="currentColor" />

            <path d="M58 40 C 53 47, 53 52, 58 52 C 63 52, 63 47, 58 40 Z" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.5 2.5" />
            <path d="M58 76 C 53 69, 53 64, 58 64 C 63 64, 63 69, 58 76 Z" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.5 2.5" />
            <path d="M40 58 C 47 53, 52 53, 52 58 C 52 63, 47 63, 40 58 Z" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.5 2.5" />
            <path d="M76 58 C 69 53, 64 53, 64 58 C 64 63, 69 63, 76 58 Z" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.5 2.5" />
            
            <path d="M30 110 Q 15 95 35 90 Q 32 105 30 110 Z" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.5 2.5" />
            <path d="M110 30 Q 95 15 90 35 Q 105 32 110 30 Z" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.5 2.5" />
            <path d="M85 70 Q 75 55 90 52 Q 92 65 85 70 Z" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.5 2.5" />
            
            <circle cx="28" cy="28" r="3" stroke="currentColor" stroke-width="1.4" />
        </svg>
    )}

    {type === 'oak-acorn' && (
        <svg viewBox="0 0 140 140" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <path d="M15 125 Q 45 95 65 55 Q 85 20 125 15" stroke="currentColor" stroke-width="1.8" stroke-dasharray="5 3.5" />
            <path d="M40 90 Q 75 80 110 95" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.5 3" />
            
            <path d="M65 55 C 55 45, 45 48, 50 38 C 42 35, 45 22, 58 20 C 65 10, 78 12, 80 22 C 90 20, 95 30, 88 38 C 96 42, 92 52, 80 50 C 75 58, 68 58, 65 55 Z" stroke="currentColor" stroke-width="1.6" stroke-dasharray="4 3" />
            <path d="M65 55 Q 70 35 75 18" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2.5 2.5" />
            <path d="M68 45 Q 60 40 54 38" stroke="currentColor" stroke-width="1" stroke-dasharray="2 2" />
            <path d="M72 35 Q 82 30 87 32" stroke="currentColor" stroke-width="1" stroke-dasharray="2 2" />
            
            <path d="M35 88 C 30 84, 45 74, 52 80 C 48 88, 38 90, 35 88 Z" stroke="currentColor" stroke-width="1.6" stroke-dasharray="3 2" />
            <path d="M37 87 C 32 98, 42 110, 48 102 C 52 96, 50 82, 48 82" stroke="currentColor" stroke-width="1.6" stroke-dasharray="3.5 2.5" />
            <circle cx="43" cy="95" r="2" fill="currentColor" />
            
            <path d="M95 90 C 105 85, 115 90, 115 80 C 125 78, 128 68, 118 62 C 118 52, 108 55, 102 65 C 92 68, 92 78, 95 90 Z" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.5 2.5" />
        </svg>
    )}

    {type === 'basketweave-border' && (
        <svg viewBox="0 0 320 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <line x1="0" y1="4" x2="320" y2="4" stroke="currentColor" stroke-width="1.8" stroke-dasharray="6 3.5" />
            <line x1="0" y1="28" x2="320" y2="28" stroke="currentColor" stroke-width="1.8" stroke-dasharray="6 3.5" />
            <line x1="0" y1="8" x2="320" y2="8" stroke="currentColor" stroke-width="1" stroke-dasharray="2.5 2.5" />
            <line x1="0" y1="24" x2="320" y2="24" stroke="currentColor" stroke-width="1" stroke-dasharray="2.5 2.5" />
            
            <path d="M10 10 L22 22 M22 10 L10 22" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3.5 2.5" />
            <path d="M30 10 L42 22 M42 10 L30 22" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3.5 2.5" />
            <path d="M50 10 L62 22 M62 10 L50 22" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3.5 2.5" />
            <path d="M70 10 L82 22 M82 10 L70 22" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3.5 2.5" />
            <path d="M90 10 L102 22 M102 10 L90 22" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3.5 2.5" />
            <path d="M110 10 L122 22 M122 10 L110 22" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3.5 2.5" />
            <path d="M130 10 L142 22 M142 10 L130 22" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3.5 2.5" />
            <path d="M150 10 L162 22 M162 10 L150 22" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3.5 2.5" />
            <path d="M170 10 L182 22 M182 10 L170 22" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3.5 2.5" />
            <path d="M190 10 L202 22 M202 10 L190 22" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3.5 2.5" />
            <path d="M210 10 L222 22 M222 10 L210 22" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3.5 2.5" />
            <path d="M230 10 L242 22 M242 10 L230 22" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3.5 2.5" />
            <path d="M250 10 L262 22 M262 10 L250 22" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3.5 2.5" />
            <path d="M270 10 L282 22 M282 10 L270 22" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3.5 2.5" />
            <path d="M290 10 L302 22 M302 10 L290 22" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3.5 2.5" />
        </svg>
    )}

    {type === 'lasso-loop' && (
        <svg viewBox="0 0 200 140" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <ellipse cx="105" cy="65" rx="80" ry="45" transform="rotate(-12 105 65)" stroke="currentColor" stroke-width="1.8" stroke-dasharray="6 4" />
            <ellipse cx="105" cy="65" rx="77" ry="42" transform="rotate(-12 105 65)" stroke="currentColor" stroke-width="1.1" stroke-dasharray="3.5 3.5" />
            
            <circle cx="32" cy="85" r="7" stroke="currentColor" stroke-width="1.6" stroke-dasharray="3 2" />
            <circle cx="32" cy="85" r="3.5" stroke="currentColor" stroke-width="1.2" />
            
            <path d="M32 92 C 25 110, 50 128, 85 130 C 130 132, 175 125, 195 135" stroke="currentColor" stroke-width="1.6" stroke-dasharray="5 3.5" />
            <path d="M30 96 C 24 112, 48 129, 84 131" stroke="currentColor" stroke-width="1" stroke-dasharray="2.5 2.5" />
        </svg>
    )}

    {type === 'spur-rowel' && (
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <circle cx="50" cy="50" r="45" stroke="currentColor" stroke-width="1.6" stroke-dasharray="5 3.5" />
            <circle cx="50" cy="50" r="41" stroke="currentColor" stroke-width="1" stroke-dasharray="2.5 2.5" />
            
            <path d="M50 8 L54 36 L79 21 L64 46 L92 50 L64 54 L79 79 L54 64 L50 92 L46 64 L21 79 L36 54 L8 50 L36 46 L21 21 L46 36 Z" stroke="currentColor" stroke-width="1.6" stroke-dasharray="4 3" />
            
            <circle cx="50" cy="50" r="13" stroke="currentColor" stroke-width="1.6" stroke-dasharray="3.5 2.5" />
            <circle cx="50" cy="50" r="7" stroke="currentColor" stroke-width="1.3" />
            <circle cx="50" cy="50" r="2.5" fill="currentColor" />
        </svg>
    )}

    {type === 'concho-rosette' && (
        <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <circle cx="60" cy="60" r="54" stroke="currentColor" stroke-width="1.8" stroke-dasharray="5 3.5" />
            <circle cx="60" cy="60" r="49" stroke="currentColor" stroke-width="1.1" stroke-dasharray="2.5 2.5" />
            <circle cx="60" cy="60" r="38" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.5 3" />
            
            <path d="M60 12 C 52 28, 52 38, 60 44 C 68 38, 68 28, 60 12 Z" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3.5 2.5" />
            <path d="M60 108 C 52 92, 52 82, 60 76 C 68 82, 68 92, 60 108 Z" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3.5 2.5" />
            <path d="M12 60 C 28 52, 38 52, 44 60 C 38 68, 28 68, 12 60 Z" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3.5 2.5" />
            <path d="M108 60 C 92 52, 82 52, 76 60 C 82 68, 92 68, 108 60 Z" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3.5 2.5" />
            <path d="M26 26 C 40 34, 46 42, 49 51 C 42 46, 34 40, 26 26 Z" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.5 2.5" />
            <path d="M94 94 C 80 86, 74 78, 71 69 C 78 74, 86 80, 94 94 Z" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.5 2.5" />
            <path d="M94 26 C 86 40, 78 46, 69 49 C 74 42, 80 34, 94 26 Z" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.5 2.5" />
            <path d="M26 94 C 40 86, 46 78, 49 69 C 42 74, 34 80, 26 94 Z" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3.5 2.5" />
            
            <circle cx="60" cy="60" r="17" stroke="currentColor" stroke-width="1.6" stroke-dasharray="3.5 2.5" />
            <circle cx="60" cy="60" r="9" stroke="currentColor" stroke-width="1.3" />
            <circle cx="60" cy="60" r="3.5" fill="currentColor" />
        </svg>
    )}

    {type === 'wild-rose' && (
        <svg viewBox="0 0 90 90" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <path d="M45 45 C 35 25, 40 10, 45 12 C 50 10, 55 25, 45 45 Z" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3.5 2.5" />
            <path d="M45 45 C 65 35, 80 40, 78 45 C 80 50, 65 55, 45 45 Z" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3.5 2.5" />
            <path d="M45 45 C 55 65, 50 80, 45 78 C 40 80, 35 65, 45 45 Z" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3.5 2.5" />
            <path d="M45 45 C 25 55, 10 50, 12 45 C 10 40, 25 35, 45 45 Z" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3.5 2.5" />
            <circle cx="45" cy="45" r="11" stroke="currentColor" stroke-width="1.6" stroke-dasharray="3 2" />
            <circle cx="45" cy="45" r="5.5" stroke="currentColor" stroke-width="1.3" />
            <circle cx="45" cy="45" r="2" fill="currentColor" />
            
            <path d="M28 28 L35 35 M62 28 L55 35 M62 62 L55 55 M28 62 L35 55" stroke="currentColor" stroke-width="1.4" stroke-dasharray="2.5 2.5" />
        </svg>
    )}
</div>
