---
import Layout from '../layouts/Layout.astro';
import WesternDecor from '../components/WesternDecor.astro';
import { blogPosts } from '../data/blogPosts';
---

<Layout
    title="Artigos Técnicos & Dicas Country — Indiana Ranch"
    description="Acervo técnico sobre selaria, arreios, proteção equina e desempenho nas pistas por especialistas e atletas da Indiana Ranch."
    currentPath="/blog"
>
<main class="py-16 sm:py-20 bg-paper-texture border-b border-divider-rustic relative overflow-hidden">
        <!-- ELEMENTOS TRACEJADOS OAK & SHERIDAN NO FUNDO DO ACERVO DE ARTIGOS -->
        <WesternDecor type="oak-acorn" class="absolute top-2 left-2 w-36 h-36 sm:w-48 sm:h-48" opacity="opacity-30" />
        <WesternDecor type="sheridan-corner" flip="both" class="absolute bottom-4 right-4 w-40 h-40 sm:w-52 sm:h-52" opacity="opacity-30" />

        <div class="container-shell">
            <!-- BREADCRUMB -->
            <nav aria-label="Navegação estrutural" class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-6 uppercase tracking-wider">
                <a href="/" class="hover:text-[#B91C1C] transition-colors">Início</a>
                <span class="text-slate-300">/</span>
                <span class="text-[#B91C1C] font-bold">Artigos & Dicas</span>
            </nav>

            <div class="max-w-3xl mb-8">
                <span class="badge-indiana px-3.5 py-1.5 inline-block mb-3 rounded-[3px]">Acervo Técnico & Conteúdo</span>
                <h1 class="font-western text-3xl sm:text-5xl lg:text-6xl text-[#000726] tracking-tight leading-tight">
                    ARTIGOS TÉCNICOS & DICAS DO CAMPO
                </h1>
                <p class="text-slate-700 text-sm sm:text-base lg:text-lg mt-4 leading-relaxed font-sans">
                    Guias práticos sobre cuidados com o cavalo, regulagem milimétrica de arreamento, conservação de couro legítimo e tendências do hipismo western.
                </p>
            </div>

            <!-- FILTROS POR CATEGORIA -->
            <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-10 no-scrollbar" aria-label="Filtrar por tema">
                <button type="button" data-filter="all" class="filter-btn active px-4 py-2 rounded-[3px] text-xs font-bold uppercase tracking-wider transition-all border border-[#000726]/20 bg-[#000726] text-white cursor-pointer shrink-0">
                    Todos os Artigos
                </button>
                <button type="button" data-filter="ortopedia" class="filter-btn px-4 py-2 rounded-[3px] text-xs font-bold uppercase tracking-wider transition-all border border-[#000726]/20 bg-white hover:bg-slate-100 text-[#000726] cursor-pointer shrink-0">
                    Mantas & Dorso
                </button>
                <button type="button" data-filter="embocaduras" class="filter-btn px-4 py-2 rounded-[3px] text-xs font-bold uppercase tracking-wider transition-all border border-[#000726]/20 bg-white hover:bg-slate-100 text-[#000726] cursor-pointer shrink-0">
                    Freios & Embocaduras
                </button>
                <button type="button" data-filter="lacos" class="filter-btn px-4 py-2 rounded-[3px] text-xs font-bold uppercase tracking-wider transition-all border border-[#000726]/20 bg-white hover:bg-slate-100 text-[#000726] cursor-pointer shrink-0">
                    Cordas & Laços
                </button>
                <button type="button" data-filter="protecao" class="filter-btn px-4 py-2 rounded-[3px] text-xs font-bold uppercase tracking-wider transition-all border border-[#000726]/20 bg-white hover:bg-slate-100 text-[#000726] cursor-pointer shrink-0">
                    Proteção Equina
                </button>
                <button type="button" data-filter="b2b" class="filter-btn px-4 py-2 rounded-[3px] text-xs font-bold uppercase tracking-wider transition-all border border-[#000726]/20 bg-white hover:bg-slate-100 text-[#000726] cursor-pointer shrink-0">
                    Atacado B2B
                </button>
                <button type="button" data-filter="couro" class="filter-btn px-4 py-2 rounded-[3px] text-xs font-bold uppercase tracking-wider transition-all border border-[#000726]/20 bg-white hover:bg-slate-100 text-[#000726] cursor-pointer shrink-0">
                    Couro Legítimo
                </button>
            </div>

            <!-- GRID DOS ARTIGOS -->
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10">

                {blogPosts.map((post, idx) => (
                    <article class="article-item relative pt-4 flex flex-col" data-cat={post.filterCat}>
                        <!-- Tacha / Concho 3D -->
                        <div class="absolute -top-3 left-1/2 -translate-x-1/2 z-30 pointer-events-none drop-shadow-[0_4px_6px_rgba(0,0,0,0.45)]">
                            <svg class="w-8 h-8" viewBox="0 0 32 32">
                                <defs>
                                    <radialGradient id={`tackBlog_${idx}`} cx="35%" cy="30%" r="65%">
                                        <stop offset="0%" stop-color="#FDE68A" />
                                        <stop offset="35%" stop-color="#D97706" />
                                        <stop offset="70%" stop-color="#92400E" />
                                        <stop offset="100%" stop-color="#451A03" />
                                    </radialGradient>
                                </defs>
                                <circle cx="16" cy="16" r="14.5" fill="#291205" opacity="0.4" />
                                <circle cx="16" cy="16" r="13" fill="#5C2607" stroke="#78350F" stroke-width="0.75" />
                                <circle cx="16" cy="16" r="10.5" fill={`url(#tackBlog_${idx})`} stroke="#78350F" stroke-width="0.8" />
                                <path d="M16 9.5 L17.4 14.6 L22.5 16 L17.4 17.4 L16 22.5 L14.6 17.4 L9.5 16 L14.6 14.6 Z" fill="#3B1705" opacity="0.85" />
                                <circle cx="16" cy="16" r="1.5" fill="#FEF3C7" />
                                <ellipse cx="13" cy="11" rx="2.5" ry="1.2" fill="#FFFFFF" opacity="0.65" transform="rotate(-25 13 11)" />
                            </svg>
                        </div>

                        <!-- Cartaz Pergaminho -->
                        <div class="w-full relative bg-paper-texture border-2 border-[#000726] p-6 sm:p-7 shadow-[0_15px_35px_rgba(0,7,38,0.08)] rounded-[2px] flex-1 flex flex-col justify-between group hover:-translate-y-1 transition-all duration-300">
                            <div class="pointer-events-none absolute inset-2 border border-[#000726]/40 rounded-[1px] z-10"></div>
                            <div class="pointer-events-none absolute inset-3 border border-dashed border-[#B91C1C]/35 rounded-[1px] z-10"></div>
                            <span class="pointer-events-none absolute top-2 left-2 text-[#000726]/60 font-western text-xs z-20">✦</span>
                            <span class="pointer-events-none absolute top-2 right-2 text-[#000726]/60 font-western text-xs z-20">✦</span>
                            <span class="pointer-events-none absolute bottom-2 left-2 text-[#000726]/60 font-western text-xs z-20">✦</span>
                            <span class="pointer-events-none absolute bottom-2 right-2 text-[#000726]/60 font-western text-xs z-20">✦</span>

                            <div class="relative z-20">
                                <!-- IMAGEM DO CARD (CLICÁVEL) -->
                                <a href={`/blog/${post.slug}`} class="block mb-4 overflow-hidden rounded-[2px] border border-[#000726]/30 shadow-xs relative aspect-[16/10] group/img">
                                    <img
                                        src={post.image}
                                        alt={post.title}
                                        width="400"
                                        height="250"
                                        loading="lazy"
                                        decoding="async"
                                        class="w-full h-full object-cover group-hover/img:scale-105 transition-transform duration-500"
                                    />
                                    <div class="absolute inset-0 bg-black/10 group-hover/img:bg-transparent transition-colors"></div>
                                </a>

                                <div class="flex items-center justify-between text-[11px] mb-3 pb-2 border-b border-[#000726]/15">
                                    <span class="badge-indiana px-2 py-0.5 rounded-[3px]">{post.badge}</span>
                                    <span class="text-slate-500 font-semibold">{post.date}</span>
                                </div>

                                <h2 class="font-western text-xl sm:text-2xl text-[#000726] leading-snug mb-3 group-hover:text-[#B91C1C] transition-colors">
                                    <a href={`/blog/${post.slug}`} class="hover:underline">
                                        {post.title}
                                    </a>
                                </h2>

                                <p class="text-xs text-slate-700 leading-relaxed mb-4">
                                    {post.description}
                                </p>

                                <div class="p-3 bg-white/80 border border-[#000726]/15 rounded-[3px] text-xs text-slate-700 space-y-1.5 mb-4">
                                    <strong class="text-[#000726] block text-[11px] uppercase tracking-wider">Pontos-chave do guia:</strong>
                                    {post.bullets.map((b) => (
                                        <div>• {b}</div>
                                    ))}
                                </div>
                            </div>

                            <!-- AÇÕES DO CARD: BOTÃO LER ARTIGO + WHATSAPP -->
                            <div class="relative z-20 pt-4 border-t border-[#000726]/15 flex items-center justify-between gap-3">
                                <a
                                    href={`/blog/${post.slug}`}
                                    class="btn btn-indiana-red text-xs py-2 px-3.5 uppercase font-bold tracking-wider rounded-[2px] flex items-center gap-1.5 shadow-xs"
                                >
                                    <span>Ler Artigo</span>
                                    <span>&rarr;</span>
                                </a>
                                <a
                                    href={`https://wa.me/5518996652244?text=Ola%2C%20li%20o%20artigo%20'${encodeURIComponent(post.title)}'%20e%20gostaria%20de%20tirar%20duvidas`}
                                    target="_blank"
                                    rel="noopener"
                                    class="text-[11px] font-bold text-slate-600 hover:text-emerald-700 transition-colors flex items-center gap-1"
                                    title="Tirar dúvidas no WhatsApp"
                                >
                                    <svg class="w-3.5 h-3.5 fill-current text-emerald-600 shrink-0" viewBox="0 0 24 24">
                                        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                                    </svg>
                                    <span>WhatsApp</span>
                                </a>
                            </div>
                        </div>
                    </article>
                ))}

            </div>

            <!-- BANNER INFERIOR ATACADO & COTAÇÕES -->
            <div class="mt-16 relative pt-4">
                <div class="absolute -top-3 left-1/2 -translate-x-1/2 z-30 pointer-events-none drop-shadow-[0_4px_6px_rgba(0,0,0,0.45)]">
                    <svg class="w-8 h-8" viewBox="0 0 32 32">
                        <defs>
                            <radialGradient id="tackBlogCta" cx="35%" cy="30%" r="65%">
                                <stop offset="0%" stop-color="#FDE68A" />
                                <stop offset="35%" stop-color="#D97706" />
                                <stop offset="70%" stop-color="#92400E" />
                                <stop offset="100%" stop-color="#451A03" />
                            </radialGradient>
                        </defs>
                        <circle cx="16" cy="16" r="14.5" fill="#291205" opacity="0.4" />
                        <circle cx="16" cy="16" r="13" fill="#5C2607" stroke="#78350F" stroke-width="0.75" />
                        <circle cx="16" cy="16" r="10.5" fill="url(#tackBlogCta)" stroke="#78350F" stroke-width="0.8" />
                        <path d="M16 9.5 L17.4 14.6 L22.5 16 L17.4 17.4 L16 22.5 L14.6 17.4 L9.5 16 L14.6 14.6 Z" fill="#3B1705" opacity="0.85" />
                        <circle cx="16" cy="16" r="1.5" fill="#FEF3C7" />
                        <ellipse cx="13" cy="11" rx="2.5" ry="1.2" fill="#FFFFFF" opacity="0.65" transform="rotate(-25 13 11)" />
                    </svg>
                </div>

                <div class="w-full relative bg-paper-texture border-2 border-[#000726] p-7 sm:p-10 shadow-[0_20px_45px_rgba(0,7,38,0.12)] rounded-[2px]">
                    <div class="pointer-events-none absolute inset-2 border border-[#000726]/40 rounded-[1px] z-10"></div>
                    <div class="pointer-events-none absolute inset-3 border border-dashed border-[#B91C1C]/35 rounded-[1px] z-10"></div>
                    <span class="pointer-events-none absolute top-2 left-2 text-[#000726]/60 font-western text-xs z-20">✦</span>
                    <span class="pointer-events-none absolute top-2 right-2 text-[#000726]/60 font-western text-xs z-20">✦</span>
                    <span class="pointer-events-none absolute bottom-2 left-2 text-[#000726]/60 font-western text-xs z-20">✦</span>
                    <span class="pointer-events-none absolute bottom-2 right-2 text-[#000726]/60 font-western text-xs z-20">✦</span>

                    <div class="relative z-20 flex flex-col lg:flex-row items-center justify-between gap-8 text-center lg:text-left">
                        <div class="max-w-2xl">
                            <span class="badge-indiana px-3 py-1 inline-block mb-2 rounded-[3px]">
                                Estoque Próprio & Pronta Entrega
                            </span>
                            <h3 class="font-western text-2xl sm:text-3xl text-[#000726] tracking-wide leading-tight">
                                Precisa abastecer sua loja ou equipe com os produtos citados?
                            </h3>
                            <p class="text-xs sm:text-sm text-slate-700 mt-2 leading-relaxed">
                                A Indiana Ranch é distribuidora direta das principais marcas americanas. Fornecemos para lojistas, haras e competidores com faturamento no CNPJ e apoio técnico na escolha dos modelos.
                            </p>
                        </div>
                        <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0 w-full lg:w-auto">
                            <a href="/contato" class="btn btn-outline-navy w-full sm:w-auto px-6 py-3 text-xs sm:text-sm uppercase font-western tracking-wider rounded-[3px]">
                                Solicitar Tabela B2B
                            </a>
                            <a href="https://wa.me/5518996652244?text=Ola%2C%20quero%20cotar%20produtos%20vistos%20no%20blog" target="_blank" rel="noopener" class="btn btn-indiana-red w-full sm:w-auto px-6 py-3 text-xs sm:text-sm uppercase font-western tracking-wider rounded-[3px] shadow-sm">
                                Falar com Especialista &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>

<script is:inline>
    // FILTRO DE ARTIGOS POR CATEGORIA
    (function initBlogFilter() {
        const filterBtns = document.querySelectorAll('.filter-btn');
        const articles = document.querySelectorAll('.article-item');

        if (!filterBtns.length || !articles.length) return;

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => {
                    b.classList.remove('active', 'bg-[#000726]', 'text-white');
                    b.classList.add('bg-white', 'text-[#000726]');
                });
                btn.classList.add('active', 'bg-[#000726]', 'text-white');
                btn.classList.remove('bg-white', 'text-[#000726]');

                const cat = btn.getAttribute('data-filter');

                articles.forEach(art => {
                    if (cat === 'all' || art.getAttribute('data-cat') === cat) {
                        art.style.display = 'flex';
                    } else {
                        art.style.display = 'none';
                    }
                });
            });
        });
    })();
</script>

</Layout>
