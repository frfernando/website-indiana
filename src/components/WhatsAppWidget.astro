---
// WhatsAppWidget.astro — 100% fiel ao protótipo (Desktop Floating + Mobile Bottom Bar)
---
<!-- ================================================================= -->
<!-- WIDGET FLUTUANTE WHATSAPP EXCLUSIVO DESKTOP (CANTO INFERIOR DIREITO) -->
<!-- ================================================================= -->
<aside id="desktop-whatsapp-widget"
    aria-label="Atendimento via WhatsApp"
    style="position: fixed; bottom: 40px; right: 28px; z-index: 9999;"
    class="hidden md:flex items-center gap-3 select-none">

    <!-- Balão Callout de Atendimento Online -->
    <div id="whatsapp-desktop-bubble"
        class="bg-white text-[#000726] pl-4 pr-3 py-2.5 rounded-[3px] border border-slate-200 border-l-4 border-l-[#0D7E3A] shadow-[0_12px_32px_rgba(0,0,0,0.18)] flex items-center gap-3 transition-all duration-300 hover:shadow-[0_16px_40px_rgba(0,0,0,0.25)]">
        <div class="relative flex h-2.5 w-2.5 shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#0D7E3A] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#0D7E3A]"></span>
        </div>
        <div class="text-left">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block leading-tight">Atendimento Online</span>
            <a href="https://wa.me/5518996652244?text=Ola%2C%20gostaria%20de%20falar%20com%20um%20consultor%20Indiana%20Ranch"
               target="_blank" rel="noopener noreferrer"
               class="text-xs font-bold text-[#000726] hover:text-[#B91C1C] transition-colors block leading-tight">
                Fale com um Especialista
            </a>
        </div>
        <button id="close-whatsapp-bubble" type="button"
                class="text-slate-400 hover:text-slate-700 text-xs ml-1 font-bold leading-none p-1 rounded hover:bg-slate-100 transition-colors cursor-pointer"
                title="Fechar aviso">✕</button>
    </div>

    <!-- Botão Flutuante Circular Principal -->
    <a href="https://wa.me/5518996652244?text=Ola%2C%20gostaria%20de%20falar%20com%20um%20consultor%20Indiana%20Ranch"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="Abrir conversa no WhatsApp Oficial"
       class="relative flex items-center justify-center w-14 h-14 rounded-full bg-[#0D7E3A] hover:bg-[#0A6B31] text-white shadow-[0_8px_25px_rgba(13,126,58,0.45)] hover:shadow-[0_12px_32px_rgba(13,126,58,0.65)] hover:scale-105 active:scale-95 transition-all duration-300 group">

        <!-- Anel de Pulso Suave -->
        <span class="absolute -inset-1 rounded-full bg-[#0D7E3A]/35 animate-pulse pointer-events-none"></span>

        <!-- Ícone WhatsApp Oficial -->
        <svg class="w-7 h-7 fill-current relative z-10 transition-transform duration-300 group-hover:rotate-12" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
    </a>
</aside>

<!-- ================================================================= -->
<!-- BARRA FIXA INFERIOR MOBILE (BOTTOM ACTION BAR / BOTTOM NAVIGATION) -->
<!-- Visível apenas no mobile (md:hidden) com WhatsApp, Google Maps e Telefone -->
<!-- ================================================================= -->
<nav aria-label="Menu de Ação Rápida Mobile"
    class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-[#000726] border-t-2 border-[#B91C1C] shadow-[0_-8px_25px_rgba(0,0,0,0.5)] px-2.5 py-2 pb-[calc(0.6rem+env(safe-area-inset-bottom))]">
    <div class="grid grid-cols-3 gap-2">

        <!-- 1. WHATSAPP -->
        <a href="https://wa.me/5518996652244?text=Ola%2C%20gostaria%20de%20falar%20com%20um%20consultor%20Indiana%20Ranch"
            target="_blank" rel="noopener"
            class="flex flex-col items-center justify-center py-2 px-1 rounded-[3px] bg-[#0D7E3A] text-white active:scale-95 transition-transform shadow-sm">
            <svg class="w-5 h-5 fill-current mb-0.5" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span class="text-[11px] font-bold tracking-wide uppercase leading-none">WhatsApp</span>
        </a>

        <!-- 2. GOOGLE MAPS -->
        <a href="https://www.google.com/maps?cid=11987966496231276786"
            target="_blank" rel="noopener"
            class="flex flex-col items-center justify-center py-2 px-1 rounded-[3px] bg-white/10 hover:bg-white/15 text-white active:scale-95 transition-transform border border-white/10 shadow-sm">
            <svg class="w-5 h-5 fill-none stroke-current mb-0.5 text-amber-400" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span class="text-[11px] font-bold tracking-wide uppercase leading-none">Como Chegar</span>
        </a>

        <!-- 3. TELEFONE -->
        <a href="tel:+5518996652244"
            class="flex flex-col items-center justify-center py-2 px-1 rounded-[3px] bg-[#B91C1C] text-white active:scale-95 transition-transform shadow-sm">
            <svg class="w-5 h-5 fill-none stroke-current mb-0.5" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span class="text-[11px] font-bold tracking-wide uppercase leading-none">Ligar Agora</span>
        </a>

    </div>
</nav>

<script is:inline>
(function initWhatsAppBubble() {
    const bubble = document.getElementById('whatsapp-desktop-bubble');
    const closeBtn = document.getElementById('close-whatsapp-bubble');
    if (closeBtn && bubble) {
        closeBtn.addEventListener('click', (e) => {
            e.preventDefault();
            bubble.style.opacity = '0';
            bubble.style.transform = 'translateX(20px)';
            setTimeout(() => {
                bubble.style.display = 'none';
            }, 300);
        });
    }
})();
</script>
