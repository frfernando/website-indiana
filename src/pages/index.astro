---
import Layout from '../layouts/Layout.astro';
import WesternDecor from '../components/WesternDecor.astro';
---

<Layout 
    title="Indiana Ranch — Artigos para Cavalo, Montaria e Country Western"
    description="Indiana Ranch: Importadora e distribuidora country oficial. Artigos para cavalo, montaria, selaria, proteção equina, atletas parceiros e marcas importadas."
    currentPath="/"
>
<main id="top">

        <!-- 3. HERO SECTION (DEGRADÊ CINEMATOGRÁFICO 2026 COM VÍDEOS EM LOOP) -->
        <section id="hero-section" class="text-white relative overflow-hidden border-b-4 border-[#B91C1C] min-h-[calc(100vh-110px)] min-h-[calc(100svh-110px)] flex flex-col justify-center py-8 sm:py-12 lg:py-14" style="background: radial-gradient(circle at 85% 20%, rgba(255, 255, 255, 0.20) 0%, transparent 50%), radial-gradient(circle at 15% 80%, rgba(13, 91, 166, 0.30) 0%, transparent 45%), linear-gradient(135deg, #000726 0%, #080E33 45%, #050C2E 80%, #000418 100%);">
            <!-- SPOTLIGHT DINÂMICO 120HZ (LUZ ESPECULAR QUE ACOMPANHA O CURSOR NO HERO) -->
            <div id="hero-spotlight" class="absolute inset-0 pointer-events-none z-[3] transition-opacity duration-500 opacity-0 md:opacity-100" style="background: radial-gradient(750px circle at var(--mouse-x, 50%) var(--mouse-y, 40%), rgba(255, 255, 255, 0.08), transparent 60%);" aria-hidden="true"></div>
            
            <!-- BACKGROUND VIDEO PLAYER RANDÔMICO (ESTILO 2026 ASYMMETRIC GRADIENT) -->
            <div class="absolute inset-0 w-full h-full overflow-hidden z-0 pointer-events-none">
                <video id="hero-bg-video" autoplay muted playsinline webkit-playsinline="true" preload="metadata" aria-hidden="true" tabindex="-1" class="w-full h-full object-cover opacity-75 scale-105 transition-opacity duration-1000" src="/videos/15922943_1280_720_24fps.mp4">
                    <track kind="captions" src="/videos/captions-pt.vtt" srclang="pt" label="Português" />
                </video>
                
                <!-- GRADIENTE CINEMATOGRÁFICO CONTÍNUO E ULTRA SUAVE (AZUL -> BRANCO) -->
                <div class="hero-smooth-blend"></div>
                
                <!-- ACENTOS DE LUZ AMBIENTE 2026 (COBALTO + BRASA BORDO) -->
                <div class="absolute -right-20 top-1/2 -translate-y-1/2 w-[450px] h-[450px] bg-white/20 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute -left-20 bottom-0 w-[450px] h-[450px] bg-[#0D5BA6]/25 rounded-full blur-3xl pointer-events-none"></div>
                
                <!-- MICRO TEXTURA DE ALTA DEFINIÇÃO -->
                <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.95)_1.5px,transparent_1.5px)] [background-size:26px_26px] opacity-[0.38] pointer-events-none"></div>
                <!-- PONTOS PISCANDO SUTILMENTE EM ÁREAS ALEATÓRIAS -->
                <div class="absolute inset-0 pointer-events-none overflow-hidden z-[2]">
                    <span class="twinkle-dot" style="top: 14%; left: 18%; --twinkle-dur: 3.8s; --twinkle-del: 0.5s;"></span>
                    <span class="twinkle-dot" style="top: 28%; left: 78%; --twinkle-dur: 4.5s; --twinkle-del: 1.8s;"></span>
                    <span class="twinkle-dot" style="top: 42%; left: 32%; --twinkle-dur: 3.2s; --twinkle-del: 2.7s;"></span>
                    <span class="twinkle-dot" style="top: 65%; left: 88%; --twinkle-dur: 4.1s; --twinkle-del: 0.9s;"></span>
                    <span class="twinkle-dot" style="top: 78%; left: 12%; --twinkle-dur: 3.5s; --twinkle-del: 3.2s;"></span>
                    <span class="twinkle-dot" style="top: 22%; left: 45%; --twinkle-dur: 4.8s; --twinkle-del: 1.2s;"></span>
                    <span class="twinkle-dot" style="top: 85%; left: 62%; --twinkle-dur: 3.9s; --twinkle-del: 2.1s;"></span>
                    <span class="twinkle-dot" style="top: 35%; left: 92%; --twinkle-dur: 4.3s; --twinkle-del: 3.8s;"></span>
                    <span class="twinkle-dot" style="top: 55%; left: 15%; --twinkle-dur: 3.6s; --twinkle-del: 1.5s;"></span>
                    <span class="twinkle-dot" style="top: 72%; left: 40%; --twinkle-dur: 4.6s; --twinkle-del: 4.0s;"></span>
                    <span class="twinkle-dot" style="top: 18%; left: 68%; --twinkle-dur: 3.4s; --twinkle-del: 2.4s;"></span>
                    <span class="twinkle-dot" style="top: 88%; left: 82%; --twinkle-dur: 4.2s; --twinkle-del: 0.2s;"></span>
                </div>
                <!-- CAMADA DE ONDA DE LUZ NOS PONTOS -->
                


            </div>

            <!-- MOLDURA COUNTRY WESTERN: PESPONTO DUPLO TIPO COSTURA DE CALÇA JEANS / SELA WESTERN -->
            <!-- Linha 1 Externa (Pesponto Jeans 1) -->
            <div class="absolute inset-2.5 sm:inset-3.5 md:inset-4 border border-dashed border-white/30 pointer-events-none z-10 rounded-[3px]"></div>
            <!-- Linha 2 Interna Paralela (Pesponto Jeans 2 - Costura Dupla Agulha Gêmea) -->
            <div class="absolute inset-[14px] sm:inset-[19px] md:inset-[22px] border border-dashed border-white/20 pointer-events-none z-10 rounded-[2px]"></div>
            
            <!-- REBITES METÁLICOS PRATA ESCOVADA FIXADOS NA BORDA DO HERO -->
            <!-- Cantos -->
            <div class="absolute top-3.5 sm:top-5 md:top-6 left-3.5 sm:left-5 md:left-6 w-2.5 h-2.5 rounded-full bg-gradient-to-tr from-slate-400 via-white to-slate-300 shadow-md border border-slate-700 pointer-events-none z-10"></div>
            <div class="absolute top-3.5 sm:top-5 md:top-6 right-3.5 sm:right-5 md:right-6 w-2.5 h-2.5 rounded-full bg-gradient-to-tr from-slate-400 via-white to-slate-300 shadow-md border border-slate-700 pointer-events-none z-10"></div>
            <div class="absolute bottom-3.5 sm:bottom-5 md:bottom-6 left-3.5 sm:left-5 md:left-6 w-2.5 h-2.5 rounded-full bg-gradient-to-tr from-slate-400 via-white to-slate-300 shadow-md border border-slate-700 pointer-events-none z-10"></div>
            <div class="absolute bottom-3.5 sm:bottom-5 md:bottom-6 right-3.5 sm:right-5 md:right-6 w-2.5 h-2.5 rounded-full bg-gradient-to-tr from-slate-400 via-white to-slate-300 shadow-md border border-slate-700 pointer-events-none z-10"></div>
            <!-- Laterais Centrais -->
            <div class="hidden md:block absolute top-1/2 -translate-y-1/2 left-3.5 sm:left-5 md:left-6 w-2.5 h-2.5 rounded-full bg-gradient-to-tr from-slate-400 via-white to-slate-300 shadow-md border border-slate-700 pointer-events-none z-10"></div>
            <div class="hidden md:block absolute top-1/2 -translate-y-1/2 right-3.5 sm:right-5 md:right-6 w-2.5 h-2.5 rounded-full bg-gradient-to-tr from-slate-400 via-white to-slate-300 shadow-md border border-slate-700 pointer-events-none z-10"></div>
            <div class="hidden md:block absolute top-3.5 sm:top-5 md:top-6 left-1/2 -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-gradient-to-tr from-slate-400 via-white to-slate-300 shadow-md border border-slate-700 pointer-events-none z-10"></div>
            <div class="hidden md:block absolute bottom-3.5 sm:bottom-5 md:bottom-6 left-1/2 -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-gradient-to-tr from-slate-400 via-white to-slate-300 shadow-md border border-slate-700 pointer-events-none z-10"></div>

            <div class="container-shell px-8 sm:px-12 md:px-16 lg:px-32 xl:px-44 2xl:px-52 relative z-10 w-full">
                <div class="grid items-center gap-10 lg:gap-12 lg:grid-cols-12">

                    <div class="lg:col-span-7 relative" id="hero-carousel-container">
                        
                        <!-- SLIDES DO CARROSSEL HERO -->
                        <div class="relative min-h-[460px] sm:min-h-[430px] lg:min-h-[400px] flex items-center">

                            <!-- SLIDE 1: DISTRIBUIDORA OFICIAL B2B PARA LOJISTAS -->
                            <div class="hero-slide active transition-all duration-700 ease-out space-y-6 w-full opacity-100 translate-y-0 relative z-10" data-slide="0">
                                <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-white/10 border border-dashed border-white/40 text-xs text-white font-semibold tracking-wide backdrop-blur-sm rounded-[3px]">
                                    <span class="w-2.5 h-2.5 bg-[#B91C1C] inline-block rounded-[3px]"></span>
                                    <span>Distribuição Oficial B2B • Desde 1994</span>
                                </div>

                                <h1 class="hero-title-bold text-2xl sm:text-4xl lg:text-5xl xl:text-[54px] tracking-[0.02em] text-white leading-[1.15] uppercase drop-shadow-lg">
                                    DISTRIBUIDORA OFICIAL WESTERN <br />
                                    PARA SUA LOJA FATURAR MAIS <br />
                                    <span class="hero-highlight">
                                        COM PRONTA ENTREGA NACIONAL.
                                    </span>
                                </h1>

                                <p class="text-base sm:text-lg text-slate-200 max-w-2xl font-normal leading-relaxed">
                                    Abasteça sua loja country com as marcas mais desejadas dos EUA. Condições exclusivas de atacado direto da importadora, faturamento facilitado no CNPJ e despacho para todo o Brasil.
                                </p>

                                <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 w-full">
                                    <a href="https://wa.me/5518996652244?text=Ola%2C%20sou%20lojista%20e%20gostaria%20de%20receber%20a%20tabela%20de%20atacado" target="_blank" rel="noopener" class="btn btn-indiana-red shimmer-sweep w-full sm:w-auto px-7 py-3.5 text-sm font-bold shadow-lg shadow-red-900/30 flex items-center justify-center gap-2.5 rounded-[3px] text-center">
                                        <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                                        <span>Solicitar Tabela de Atacado</span>
                                    </a>
                                    <a href="#diferenciais" class="btn btn-outline border-dashed border-white/50 hover:border-white text-white hover:bg-white/10 w-full sm:w-auto px-7 py-3.5 text-sm font-semibold transition-colors rounded-[3px] flex items-center justify-center text-center">
                                        Cadastrar CNPJ
                                    </a>
                                </div>

                                <div class="pt-6 border-t border-white/15 grid grid-cols-3 gap-4 text-xs text-slate-300">
                                    <div class="flex items-center gap-2">
                                        <span class="text-[#B91C1C] font-black">■</span>
                                        <span>Faturamento no CNPJ</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-[#B91C1C] font-black">■</span>
                                        <span>Descontos Progressivos</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-[#B91C1C] font-black">■</span>
                                        <span>Pronta Entrega (+2.500 Itens)</span>
                                    </div>
                                </div>
                            </div>

                            <!-- SLIDE 2: GIRO RÁPIDO E MARGEM DE LUCRO NO BALCÃO -->
                            <div class="hero-slide absolute inset-0 transition-all duration-700 ease-out space-y-6 w-full opacity-0 translate-y-4 pointer-events-none z-0" data-slide="1">
                                <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-white/10 border border-dashed border-white/40 text-xs text-white font-semibold tracking-wide backdrop-blur-sm rounded-[3px]">
                                    <span class="w-2.5 h-2.5 bg-[#B91C1C] inline-block rounded-[3px]"></span>
                                    <span>Giro Rápido & Margem no Balcão</span>
                                </div>

                                <h2 class="hero-title-bold text-2xl sm:text-4xl lg:text-5xl xl:text-[54px] tracking-[0.02em] text-white leading-[1.15] uppercase drop-shadow-lg">
                                    ARTIGOS DE ALTA ROTATIVIDADE <br />
                                    COM EXCELENTE MARGEM DE LUCRO <br />
                                    <span class="hero-highlight">
                                        E ZERO RISCO DE ENCALHE.
                                    </span>
                                </h2>

                                <p class="text-base sm:text-lg text-slate-200 max-w-2xl font-normal leading-relaxed">
                                    Mantas ortopédicas, arreios, caneleiras e embocaduras procuradas pelos principais treinadores e haras da sua região. Curadoria técnica de alta rotatividade comercial para sua vitrine.
                                </p>

                                <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 w-full">
                                    <a href="#categorias" class="btn btn-indiana-red shimmer-sweep w-full sm:w-auto px-7 py-3.5 text-sm font-bold shadow-lg shadow-red-900/30 flex items-center justify-center gap-2.5 rounded-[3px] text-center">
                                        <span>Ver Linhas de Alta Demanda</span>
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                        </svg>
                                    </a>
                                    <a href="https://wa.me/5518996652244?text=Quero%20consultoria%20de%20mix%20de%20produtos%20para%20minha%20loja" target="_blank" rel="noopener" class="btn btn-outline border-dashed border-white/50 hover:border-white text-white hover:bg-white/10 w-full sm:w-auto px-7 py-3.5 text-sm font-semibold transition-colors rounded-[3px] flex items-center justify-center text-center">
                                        Falar com Consultor B2B
                                    </a>
                                </div>

                                <div class="pt-6 border-t border-white/15 grid grid-cols-3 gap-4 text-xs text-slate-300">
                                    <div class="flex items-center gap-2">
                                        <span class="text-[#B91C1C] font-black">■</span>
                                        <span>Alta Procura Regional</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-[#B91C1C] font-black">■</span>
                                        <span>Garantia de Autenticidade</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-[#B91C1C] font-black">■</span>
                                        <span>Apoio na Montagem de Mix</span>
                                    </div>
                                </div>
                            </div>

                            <!-- SLIDE 3: IMPORTAÇÃO OFICIAL DIRETO NA SUA VITRINE -->
                            <div class="hero-slide absolute inset-0 transition-all duration-700 ease-out space-y-6 w-full opacity-0 translate-y-4 pointer-events-none z-0" data-slide="2">
                                <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-white/10 border border-dashed border-white/40 text-xs text-white font-semibold tracking-wide backdrop-blur-sm rounded-[3px]">
                                    <span class="w-2.5 h-2.5 bg-[#B91C1C] inline-block rounded-[3px]"></span>
                                    <span>Importação Oficial & Legalizada</span>
                                </div>

                                <h2 class="hero-title-bold text-2xl sm:text-4xl lg:text-5xl xl:text-[54px] tracking-[0.02em] text-white leading-[1.15] uppercase drop-shadow-lg">
                                    AS MAIORES MARCAS DOS EUA <br />
                                    DIRETO NA SUA VITRINE <br />
                                    <span class="hero-highlight">
                                        SEM BUROCRACIA DE IMPORTAÇÃO.
                                    </span>
                                </h2>

                                <p class="text-base sm:text-lg text-slate-200 max-w-2xl font-normal leading-relaxed">
                                    Produtos Classic Equine, Weaver Leather, Willard Ropes e mais, já legalizados com nota fiscal e garantia total. Seja a revenda de referência de artigos equinos na sua cidade.
                                </p>

                                <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 w-full">
                                    <a href="/contato" class="btn btn-indiana-red shimmer-sweep w-full sm:w-auto px-7 py-3.5 text-sm font-bold shadow-lg shadow-red-900/30 flex items-center justify-center gap-2.5 rounded-[3px] text-center">
                                        <span>Cadastrar Minha Loja</span>
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                        </svg>
                                    </a>
                                    <a href="#diferenciais" class="btn btn-outline border-dashed border-white/50 hover:border-white text-white hover:bg-white/10 w-full sm:w-auto px-7 py-3.5 text-sm font-semibold transition-colors rounded-[3px] flex items-center justify-center text-center">
                                        Condições de Fornecimento
                                    </a>
                                </div>

                                <div class="pt-6 border-t border-white/15 grid grid-cols-3 gap-4 text-xs text-slate-300">
                                    <div class="flex items-center gap-2">
                                        <span class="text-[#B91C1C] font-black">■</span>
                                        <span>Nota Fiscal Eletrônica</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-[#B91C1C] font-black">■</span>
                                        <span>Despacho Rápido de SP</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-[#B91C1C] font-black">■</span>
                                        <span>Suporte Comercial Dedicado</span>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- BARRA DE NAVEGAÇÃO DOS DOTS (INDICADORES DE LOOP) -->
                        <div class="mt-6 flex items-center gap-1.5 sm:gap-2" aria-label="Navegação do Carrossel Hero">
                            <button type="button" class="hero-dot group flex items-center justify-center min-w-[48px] min-h-[48px] p-2 focus:outline-none cursor-pointer" data-target="0" aria-label="Slide 1: Distribuidora Oficial B2B">
                                <span class="hero-dot-indicator w-8 h-2 bg-[#B91C1C] rounded-full transition-all duration-300 shadow-sm"></span>
                            </button>
                            <button type="button" class="hero-dot group flex items-center justify-center min-w-[48px] min-h-[48px] p-2 focus:outline-none cursor-pointer" data-target="1" aria-label="Slide 2: Giro Rápido e Margem no Balcão">
                                <span class="hero-dot-indicator w-2.5 h-2 bg-white/30 hover:bg-white/60 rounded-full transition-all duration-300"></span>
                            </button>
                            <button type="button" class="hero-dot group flex items-center justify-center min-w-[48px] min-h-[48px] p-2 focus:outline-none cursor-pointer" data-target="2" aria-label="Slide 3: Importação Oficial para Lojas">
                                <span class="hero-dot-indicator w-2.5 h-2 bg-white/30 hover:bg-white/60 rounded-full transition-all duration-300"></span>
                            </button>
                            <span class="text-[11px] text-slate-400 font-medium ml-2 tracking-wider uppercase flex items-center gap-1.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#B91C1C] animate-ping"></span>
                                Destaques Indiana Ranch
                            </span>
                        </div>

                    </div>

                    <div class="w-full max-w-md mx-auto lg:max-w-none lg:col-span-5 relative mt-8 lg:-mt-7 lg:-translate-y-5 transform lg:scale-[1.05] origin-top transition-transform">
                        <!-- TACHA DE LATÃO / OURO ENVELHECIDO REALISTA DE SELARIA (WESTERN CONCHO STUD) -->
                        <div class="absolute -top-4 left-1/2 -translate-x-1/2 z-30 pointer-events-none flex flex-col items-center">
                            <!-- Sombra de contato projetada realisticamente sobre o papel -->
                            <div class="absolute top-4 w-7 h-2.5 bg-black/45 blur-[2.5px] rounded-full"></div>
                            
                            <!-- Tacha 3D com relevo em latão envelhecido e estrela forjada -->
                            <svg class="relative w-8 h-8 drop-shadow-[0_4px_6px_rgba(0,0,0,0.6)] concho-3d" viewBox="0 0 32 32" fill="none">
                                <defs>
                                    <linearGradient id="westernTackRim" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#FDE68A" />
                                        <stop offset="30%" stop-color="#D97706" />
                                        <stop offset="70%" stop-color="#78350F" />
                                        <stop offset="100%" stop-color="#3B1705" />
                                    </linearGradient>
                                    <radialGradient id="westernTackDome" cx="35%" cy="30%" r="65%">
                                        <stop offset="0%" stop-color="#FFFBEB" />
                                        <stop offset="25%" stop-color="#FCD34D" />
                                        <stop offset="60%" stop-color="#B45309" />
                                        <stop offset="90%" stop-color="#78350F" />
                                        <stop offset="100%" stop-color="#291104" />
                                    </radialGradient>
                                </defs>
                                <!-- Chanfro de assentamento -->
                                <circle cx="16" cy="16" r="14" fill="#291104" />
                                <circle cx="16" cy="16" r="13" fill="url(#westernTackRim)" />
                                <!-- Domo metálico convexo -->
                                <circle cx="16" cy="16" r="10.5" fill="url(#westernTackDome)" stroke="#78350F" stroke-width="0.8" />
                                <!-- Florão estrela de 4 pontas entalhado no centro -->
                                <path d="M16 9.5 L17.4 14.6 L22.5 16 L17.4 17.4 L16 22.5 L14.6 17.4 L9.5 16 L14.6 14.6 Z" fill="#3B1705" opacity="0.85" />
                                <circle cx="16" cy="16" r="1.5" fill="#FEF3C7" />
                                <!-- Reflexo especular de luz superior -->
                                <ellipse cx="13" cy="11" rx="2.5" ry="1.2" fill="#FFFFFF" opacity="0.65" transform="rotate(-25 13 11)" />
                            </svg>
                        </div>

