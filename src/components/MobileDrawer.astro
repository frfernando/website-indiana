---
// MobileDrawer.astro — 100% fiel ao protótipo (completo com cards de contato e redes)
---
<!-- ================================================================= -->
    <!-- DRAWER / MENU LATERAL MOBILE OFF-CANVAS -->
    <!-- ================================================================= -->
    <div id="mobile-drawer" class="fixed inset-0 z-[100] pointer-events-none transition-opacity duration-300 opacity-0 hidden" aria-hidden="true" inert role="dialog" aria-modal="true" aria-label="Menu de Navegação Principal">
        <!-- Backdrop escuro com blur -->
        <div id="mobile-drawer-backdrop" class="absolute inset-0 bg-black/65 backdrop-blur-sm transition-opacity"></div>

        <!-- Painel Lateral Deslizante -->
        <div id="mobile-drawer-panel" class="absolute top-0 right-0 bottom-0 w-[85%] max-w-sm bg-white shadow-2xl border-l-4 border-l-[#B91C1C] flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-out overflow-y-auto">

            <!-- Topo do Drawer: Logo & Botão Fechar -->
            <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-paper-texture">
                <div class="flex items-center gap-2.5">
                    <img
                        src="/images/logo-indiana-ranch.avif"
                        alt="Indiana Ranch"
                        width="160"
                        height="40"
                        loading="lazy"
                        decoding="async"
                        class="h-10 w-auto object-contain"
                    />
                    <div class="flex flex-col">
                        <span class="font-western text-[14px] font-bold text-[#000726] leading-none">INDIANA RANCH</span>
                        <span class="text-[9px] tracking-[0.2em] uppercase font-bold text-[#B91C1C] mt-0.5">The Western Original</span>
                    </div>
                </div>
                <button id="mobile-drawer-close" aria-label="Fechar Menu" class="min-w-[48px] min-h-[48px] w-12 h-12 rounded-[3px] bg-[#000726]/5 hover:bg-[#B91C1C] text-[#000726] hover:text-white flex items-center justify-center transition-colors cursor-pointer">
                    <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- Links de Navegação -->
            <nav class="p-5 space-y-1.5 flex-1">
                <a href="/" class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-[3px] text-[#B91C1C] font-bold bg-[#B91C1C]/10 text-sm">
                    <span>Início</span>
                    <span class="text-xs">→</span>
                </a>
                <a href="/#categorias" class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-[3px] text-slate-700 hover:text-[#B91C1C] hover:bg-slate-50 font-medium text-sm transition-colors">
                    <span>Categorias Western</span>
                    <span class="text-xs text-slate-400">→</span>
                </a>
                <a href="/#marcas" class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-[3px] text-slate-700 hover:text-[#B91C1C] hover:bg-slate-50 font-medium text-sm transition-colors">
                    <span>Marcas Importadas</span>
                    <span class="text-xs text-slate-400">→</span>
                </a>
                <a href="/#diferenciais" class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-[3px] text-slate-700 hover:text-[#B91C1C] hover:bg-slate-50 font-medium text-sm transition-colors">
                    <span>Atacado para Lojistas</span>
