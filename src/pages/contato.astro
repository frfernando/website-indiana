<script is:inline>
(function() {
    const form = document.getElementById('contact-quote-form');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');
    const statusBox = document.getElementById('form-status-box');
    const phoneInput = document.getElementById('contact-whatsapp');

    // Máscara automática de WhatsApp / Telefone
    if (phoneInput) {
        phoneInput.addEventListener('input', function(e) {
            let val = e.target.value.replace(/\D/g, '');
            if (val.length > 11) val = val.substring(0, 11);
            if (val.length > 10) {
                e.target.value = val.replace(/^(\d{2})(\d{5})(\d{4})$/, '($1) $2-$3');
            } else if (val.length > 6) {
                e.target.value = val.replace(/^(\d{2})(\d{4})(\d{0,4})$/, '($1) $2-$3');
            } else if (val.length > 2) {
                e.target.value = val.replace(/^(\d{2})(\d{0,5})$/, '($1) $2');
            } else {
                e.target.value = val;
            }
        });
    }

    if (!form || !submitBtn) return;

    form.addEventListener('submit', async function(e) {
        e.preventDefault();

        // Limpa estado anterior
        statusBox.classList.add('hidden');
        statusBox.className = 'hidden rounded-[3px] p-4 text-xs font-semibold';
        statusBox.innerHTML = '';

        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        // Validação mínima no cliente
        if (!payload.name || payload.name.trim().length < 2) {
            showStatus('Por favor, informe seu nome ou razão social completo.', 'error');
            return;
        }
        if (!payload.whatsapp || payload.whatsapp.trim().length < 10) {
            showStatus('Por favor, informe seu WhatsApp completo com DDD.', 'error');
            return;
        }

        // Estado de carregamento
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-80', 'cursor-not-allowed');
        btnText.innerHTML = '<span class="inline-block animate-spin mr-2">⟳</span> Enviando para atendimento@indianaranch.com.br...';

        try {
            const response = await fetch('/api/contato', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            const result = await response.json().catch(() => ({}));

            if (response.ok && result.success) {
                showStatus(
                    '★ SOLICITAÇÃO RECEBIDA COM SUCESSO! ★<br/><span class="font-normal mt-1 block">Sua mensagem foi entregue para nossa equipe comercial (<strong>atendimento@indianaranch.com.br</strong>). Retornaremos seu contato em breve via WhatsApp e e-mail oficial.</span>',
                    'success'
                );
                form.reset();
            } else {
                const errorMsg = result.error || 'Não foi possível enviar agora. Entre em contato diretamente pelo WhatsApp oficial.';
                showStatus(errorMsg, 'error');
            }
        } catch (err) {
            showStatus(
                'Falha temporária de rede ao enviar o formulário. Por favor, utilize o botão abaixo para falar diretamente via WhatsApp.',
                'error'
            );
        } finally {
            submitBtn.disabled = false;
            submitBtn.classList.remove('opacity-80', 'cursor-not-allowed');
            btnText.textContent = 'Enviar Solicitação de Cotação';
        }
    });

    function showStatus(message, type) {
        statusBox.classList.remove('hidden');
        if (type === 'success') {
            statusBox.className = 'rounded-[3px] p-4 text-xs font-semibold bg-emerald-50 border-2 border-emerald-600 text-emerald-900 shadow-sm leading-relaxed';
            statusBox.innerHTML = message;
        } else {
            statusBox.className = 'rounded-[3px] p-4 text-xs font-semibold bg-red-50 border-2 border-[#B91C1C] text-red-900 shadow-sm leading-relaxed';
            statusBox.innerHTML = '⚠️ ' + message + ' <br/><a href="https://wa.me/5518996652244" target="_blank" class="underline font-bold text-[#B91C1C] mt-2 inline-block">Clique aqui para falar agora pelo WhatsApp &rarr;</a>';
        }
        statusBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
})();
</script>

