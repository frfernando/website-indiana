<!-- SCRIPT: PLAYER RANDÔMICO DE VÍDEOS DE FUNDO DO HERO & MICRO-INTERAÇÕES 120HZ 2026 -->
    <script is:inline>
        // 1. VIDEO PLAYER RANDÔMICO RESILIENTE
        (function() {
            const heroVideos = [
                '/videos/12280514_1280_720_25fps.mp4',
                '/videos/14440770-hd_1280_720_30fps.mp4',
                '/videos/15922943_1280_720_24fps.mp4',
                '/videos/16506198_1280_720_24fps.mp4',
                '/videos/5087762-hd_1280_720_25fps.mp4',
                '/videos/7353112-hd_1280_720_24fps.mp4'
            ];

            const videoEl = document.getElementById('hero-bg-video');
            if (!videoEl) return;

            // Garantir que atributos mobile para autoplay estejam ativos
            videoEl.muted = true;
            videoEl.defaultMuted = true;
            videoEl.setAttribute('muted', '');
            videoEl.setAttribute('playsinline', '');
            videoEl.setAttribute('webkit-playsinline', 'true');

            let lastIndex = -1;

            function getRandomVideoIndex() {
                if (heroVideos.length <= 1) return 0;
                let nextIndex;
                do {
                    nextIndex = Math.floor(Math.random() * heroVideos.length);
                } while (nextIndex === lastIndex);
                return nextIndex;
            }

            function safePlayVideo() {
                videoEl.muted = true;
                const promise = videoEl.play();
                if (promise !== undefined) {
                    promise.then(() => {
                        videoEl.style.opacity = '0.75';
                    }).catch(() => {
                        // Se o navegador mobile bloquear por economia de energia, inicia no primeiro gesto
                        const resume = () => {
                            videoEl.play().catch(() => {});
                            videoEl.style.opacity = '0.75';
                            window.removeEventListener('touchstart', resume);
                            window.removeEventListener('scroll', resume);
                            window.removeEventListener('click', resume);
                        };
                        window.addEventListener('touchstart', resume, { once: true, passive: true });
                        window.addEventListener('scroll', resume, { once: true, passive: true });
                        window.addEventListener('click', resume, { once: true, passive: true });
                    });
                }
            }

            function playNextRandomVideo() {
                const nextIdx = getRandomVideoIndex();
                lastIndex = nextIdx;
                
                videoEl.style.opacity = '0';
                
                setTimeout(() => {
                    videoEl.src = heroVideos[nextIdx];
                    videoEl.load();
                    safePlayVideo();
                }, 400);
            }

            const initialIndex = getRandomVideoIndex();
            lastIndex = initialIndex;
            videoEl.src = heroVideos[initialIndex];
            safePlayVideo();

            videoEl.addEventListener('ended', playNextRandomVideo);

            let videoErrorCount = 0;
            videoEl.addEventListener('error', () => {
                if (++videoErrorCount < heroVideos.length) {
                    setTimeout(playNextRandomVideo, 1000);
                }
            });
        })();

        // 2. SPOTLIGHT DINÂMICO A 120HZ NO HERO (ACELERAÇÃO POR GPU VIA RAF)
        (function() {
            const heroSection = document.getElementById('hero-section');
            const heroSpotlight = document.getElementById('hero-spotlight');
            if (!heroSection || !heroSpotlight) return;

            let ticking = false;
            heroSection.addEventListener('mousemove', function(e) {
                if (!ticking) {
                    window.requestAnimationFrame(function() {
                        const rect = heroSection.getBoundingClientRect();
                        const x = e.clientX - rect.left;
                        const y = e.clientY - rect.top;
                        heroSpotlight.style.setProperty('--mouse-x', x + 'px');
                        heroSpotlight.style.setProperty('--mouse-y', y + 'px');
                        ticking = false;
                    });
                    ticking = true;
                }
            }, { passive: true });
        })();

        // 3. CARROSSEL DE TEXTOS DO HERO COM LOOP E DOTS
        (function() {
            const container = document.getElementById('hero-carousel-container');
            if (!container) return;

            const slides = container.querySelectorAll('.hero-slide');
            const dots = container.querySelectorAll('.hero-dot');
            const indicators = container.querySelectorAll('.hero-dot-indicator');
            let currentSlide = 0;
            let slideInterval = null;
            const AUTO_INTERVAL = 6000;

            function showSlide(index) {
                currentSlide = index;
                slides.forEach((slide, idx) => {
                    if (idx === index) {
                        slide.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none', 'z-0', 'absolute', 'inset-0');
                        slide.classList.add('opacity-100', 'translate-y-0', 'relative', 'z-10');
                    } else {
                        slide.classList.remove('opacity-100', 'translate-y-0', 'relative', 'z-10');
                        slide.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none', 'z-0', 'absolute', 'inset-0');
                    }
                });

                indicators.forEach((indicator, idx) => {
                    if (idx === index) {
                        indicator.className = 'hero-dot-indicator w-8 h-2 bg-[#B91C1C] rounded-full transition-all duration-300 shadow-sm';
                    } else {
                        indicator.className = 'hero-dot-indicator w-2.5 h-2 bg-white/30 hover:bg-white/60 rounded-full transition-all duration-300';
                    }
                });
            }

            function nextSlide() {
                const next = (currentSlide + 1) % slides.length;
                showSlide(next);
            }

            function startAutoPlay() {
                if (slideInterval) clearInterval(slideInterval);
                slideInterval = setInterval(nextSlide, AUTO_INTERVAL);
            }

            function stopAutoPlay() {
                if (slideInterval) clearInterval(slideInterval);
            }

            dots.forEach((dot) => {
                dot.addEventListener('click', () => {
                    const target = parseInt(dot.getAttribute('data-target'), 10);
                    showSlide(target);
                    startAutoPlay();
                });
            });

            container.addEventListener('mouseenter', stopAutoPlay);
            container.addEventListener('mouseleave', startAutoPlay);

            startAutoPlay();
        })();

        // 4. CONTROLE UNIFICADO DAS ABAS & SLIDER INFINITO COM SETAS E TOUCH MAGNÉTICO
        (function() {
            const tabs = document.querySelectorAll('.cat-tab-btn');
            const panels = document.querySelectorAll('.cat-panel');
            const prevBtn = document.getElementById('cat-slider-prev');
            const nextBtn = document.getElementById('cat-slider-next');
            const container = document.getElementById('cat-panels-container');
            if (!tabs.length || !panels.length) return;

            const total = panels.length; // 6 categorias (0 a 5)
            let currentIndex = 0;
            const counterEl = document.getElementById('cat-slider-counter');

            function goToCategory(targetIndex, animate = true) {
                // Loop infinito (wrap around)
                currentIndex = (targetIndex + total) % total;

                // Atualizar contador Stories
                if (counterEl) {
                    counterEl.textContent = String(currentIndex + 1).padStart(2, '0');
                }

                // Atualizar abas
                tabs.forEach(t => {
                    const isActive = parseInt(t.getAttribute('data-tab'), 10) === currentIndex;
                    if (isActive) {
                        t.classList.add('active');
                        t.setAttribute('aria-selected', 'true');
                        // No mobile, rolar suavemente a barra de abas até o item ativo
                        if (window.innerWidth < 768) {
                            t.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
                        }
                    } else {
                        t.classList.remove('active');
                        t.setAttribute('aria-selected', 'false');
                    }
                });

                // Transição suave dos painéis
                panels.forEach(panel => {
                    const isTarget = parseInt(panel.getAttribute('data-panel'), 10) === currentIndex;
                    if (isTarget) {
                        panel.classList.add('active');
                    } else {
                        panel.classList.remove('active');
                    }
                });

                // Ao clicar em uma aba de categoria no mobile, rola a página suavemente para o início da seção de categorias
                if (window.innerWidth < 1024) {
                    const catSection = document.getElementById('categorias');
                    if (catSection) {
                        const targetY = catSection.getBoundingClientRect().top + window.pageYOffset - 70;
                        window.scrollTo({
                            top: targetY,
                            behavior: 'smooth'
                        });
                    }
                }
            }

            // Ações de clique nas abas
            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    const targetIndex = parseInt(tab.getAttribute('data-tab'), 10);
                    goToCategory(targetIndex);
                });
            });

            // Ações das setas laterais (loop infinito) em todos os painéis
            document.querySelectorAll('.cat-slider-prev-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    goToCategory(currentIndex - 1);
                });
            });
            document.querySelectorAll('.cat-slider-next-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    goToCategory(currentIndex + 1);
                });
            });

            // Gesto Swipe Touch Magnético no Mobile
            if (container) {
                let startX = 0;
                let startY = 0;
                let isSwiping = false;

                container.addEventListener('touchstart', (e) => {
                    if (e.touches.length === 1) {
                        startX = e.touches[0].clientX;
                        startY = e.touches[0].clientY;
                        isSwiping = true;
                    }
                }, { passive: true });

                container.addEventListener('touchend', (e) => {
                    if (!isSwiping || e.changedTouches.length !== 1) return;
                    isSwiping = false;

                    const endX = e.changedTouches[0].clientX;
                    const endY = e.changedTouches[0].clientY;
                    const diffX = endX - startX;
                    const diffY = endY - startY;

                    // Se o movimento for predominantemente horizontal e superior a 40px
                    if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
                        if (diffX < 0) {
                            // Arrastou para a esquerda -> Próximo
                            goToCategory(currentIndex + 1);
                        } else {
                            // Arrastou para a direita -> Anterior
                            goToCategory(currentIndex - 1);
                        }
                    }
                }, { passive: true });
            }
        })();
        // 5. PLAYLIST SEQUENCIAL DE VÍDEOS EM LOOP COM PRÉ-CARREGAMENTO EM SEGUNDO PLANO (LAZY PRELOAD)
        (function() {
            const videoEl = document.getElementById('selaria-sequential-video');
            if (!videoEl) return;

            // Lista da playlist: vídeo principal + 7 vídeos da pasta
            const playlist = [
                '/videos/video-selaria-equipamentos.mp4',
                '/videos/video-categoria-2.mp4',
                '/videos/video-categoria-3.mp4',
                '/videos/video-categoria-4.mp4',
                '/videos/video-categoria-5.mp4',
                '/videos/video-categoria-6.mp4',
                '/videos/video-categoria-7.mp4',
                '/videos/video-categoria-8.mp4'
            ];

            let currentTrack = 0;
            let preloaderVideo = null;

            // Função para pré-carregar o PRÓXIMO vídeo em segundo plano sem travar a rede
            function preloadNext(index) {
                const nextTrack = (index + 1) % playlist.length;
                if (!preloaderVideo) {
                    preloaderVideo = document.createElement('video');
                    preloaderVideo.preload = 'auto';
                    preloaderVideo.muted = true;
                }
                preloaderVideo.src = playlist[nextTrack];
            }

            // Pré-carrega o 2º vídeo após 3 segundos da reprodução inicial do 1º
            setTimeout(() => {
                preloadNext(0);
            }, 3000);

            function switchVideo() {
                currentTrack = (currentTrack + 1) % playlist.length;
                
                // Transição suave
                videoEl.style.opacity = '0.7';
                videoEl.src = playlist[currentTrack];
                
                const playPromise = videoEl.play();
                if (playPromise !== undefined) {
                    playPromise.then(() => {
                        videoEl.style.opacity = '1';
                        preloadNext(currentTrack);
                    }).catch(() => {
                        videoEl.style.opacity = '1';
                    });
                }
            }

            // Garante a troca exata de 7 em 7 segundos ou ao final do vídeo
            videoEl.addEventListener('ended', switchVideo);

            // Troca também por tempo caso algum leitor tenha variação de frame
            videoEl.addEventListener('timeupdate', function() {
                if (videoEl.currentTime >= 6.8) {
                    switchVideo();
                }
            });

            // Se der erro em algum vídeo da playlist, salta direto para o próximo
            videoEl.addEventListener('error', function() {
                currentTrack = (currentTrack + 1) % playlist.length;
                videoEl.src = playlist[currentTrack];
                videoEl.play().catch(() => {});
            });
        })();

        // 6. LOOP DE SLIDESHOW DE IMAGENS DE VESTUÁRIO (TROCA A CADA 3 SEGUNDOS)
        (function() {
            const container = document.getElementById('vestuario-slideshow-container');
            if (!container) return;

            const slides = container.querySelectorAll('.vestuario-slide');
            if (slides.length <= 1) return;

            let currentSlideIdx = 0;

            function nextVestuarioSlide() {
                const prevSlide = slides[currentSlideIdx];
                currentSlideIdx = (currentSlideIdx + 1) % slides.length;
                const nextSlide = slides[currentSlideIdx];

                // Fazer transição suave de opacidade
                prevSlide.classList.remove('opacity-100', 'z-10');
                prevSlide.classList.add('opacity-0', 'z-0');

                nextSlide.classList.remove('opacity-0', 'z-0');
                nextSlide.classList.add('opacity-100', 'z-10');
            }

            setInterval(nextVestuarioSlide, 3000);
        })();
    </script>

